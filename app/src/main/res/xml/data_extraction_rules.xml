<?xml version="1.0" encoding="utf-8"?>
<!-- Back up corrections and settings; the scan cache is rebuilt on a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="forwardsweep.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
</data-extraction-rules>
